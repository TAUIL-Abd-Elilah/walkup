# Qloo hackathon key: server-side only. Base URL must be the hackathon host.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Ticketmaster Discovery API (developer.ticketmaster.com)
TICKETMASTER_API_KEY=
# Google Places API (New), used only for the fair-control arm and grounding checks
GOOGLE_PLACES_API_KEY=
# Census API key (free). Keyless requests were redirected to a missing-key page in Oct 2026.
CENSUS_API_KEY=
# Anthropic (narrator + fair-control arm)
ANTHROPIC_API_KEY=
# Resend (confirm-gated send)
RESEND_API_KEY=
RESEND_FROM=
# Send step: signs confirm tokens and keys the IP hashes of the caps (at least 32 characters,
# e.g. `openssl rand -hex 32`). Unset: a random secret per process, so a prepared send cannot be
# confirmed after a restart.
WALKUP_SIGNING_SECRET=
# Physical postal address printed in every email footer. A real send is refused without it.
# A literal \n becomes a line break.
WALKUP_POSTAL_ADDRESS=
# Runtime
WALKUP_DATA_DIR=./.cache
WALKUP_MODE=auto   # auto | live | fixture
# Optional overrides (all have safe defaults; see the package READMEs)
# QLOO_MONTH_GUARD_FLOOR=1500        refuse fresh Qloo calls below this many calls left this month
# WALKUP_RECORD=1               live mode only: write Qloo bodies to fixtures/raw (git-ignored)
# WALKUP_FIXTURES_DIR=          default: the nearest fixtures/ above the working directory
# WALKUP_GAZETTEER_DIR=         default: data/gazetteer/out
# WALKUP_TAGS_FILE=             default: the nearest config/tags.json above the working directory
# QLOO_ALLOW_HOST=1                  local mock servers only: accept a non-Qloo base URL
# WALKUP_URL=http://localhost:3000   server the agent skill CLI talks to
# Web app caps and storage
# WALKUP_FRESH_RUNS_PER_IP=3    fresh (live) runs per network per UTC day
# WALKUP_FRESH_RUNS_PER_DAY=15  fresh runs per UTC day in total
# WALKUP_PLAN_STORE=            "memory" keeps plans in memory instead of ${WALKUP_DATA_DIR}/plans.sqlite
# WALKUP_SEND_DAILY_CAP=10      confirmed sends per network per UTC day
